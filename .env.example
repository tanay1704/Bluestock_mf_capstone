# ==============================================================================
# Bluestock Fintech Mutual Fund Analytics Platform - Environment Template
# ==============================================================================

# API Configurations
MFAPI_BASE_URL=https://api.mfapi.in/mf

# Database Configuration
SQLITE_DB_PATH=data/db/bluestock_mf.db
DATABASE_URL=sqlite:///data/db/bluestock_mf.db

# Authentication & Cryptographic Security (Strictly Server-Side)
AUTH_SECRET_KEY=change-to-a-cryptographically-secure-random-key-in-production
SESSION_EXPIRY_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
EMAIL_VERIFY_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_MINUTES=15

# Automated Telemetry & SMTP Alert Notifications (Strictly Server-Side)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=alerts-noreply@bluestock.in
RECIPIENT_EMAIL=portfolio-ops@bluestock.in
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here

# Optional AI Assistant Key (Strictly Server-Side - Never Exposed to Frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Microservice Configuration
FLASK_APP=scripts/app.py
FLASK_ENV=production
PORT=5000
